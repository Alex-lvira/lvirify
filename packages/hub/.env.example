# ---- lvirify hub ----

# Port the hub listens on. (Render sets PORT itself.)
PORT=3000

# Shown in the dashboard header.
HUB_NAME=Office

# Shared secret companions must present to publish, also used to sign cookies.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HUB_SECRET=change-me

# Public HTTPS URL of this hub. Spotify and Slack redirect the browser here
# after login, so it must be reachable from the internet over HTTPS:
#   local testing: your ngrok / cloudflared tunnel URL
#   Render:        set automatically from RENDER_EXTERNAL_URL (leave unset)
#   on the Pi:     e.g. https://lvirify.<tailnet>.ts.net (tailscale serve)
PUBLIC_URL=https://example.ngrok-free.app

# Spotify developer app client id (public). Used for "join from the site" and
# handed to companions so colleagues do not have to copy it around.
# The Spotify app must list <PUBLIC_URL>/spotify/callback as a redirect URI.
SPOTIFY_CLIENT_ID=

# Slack app credentials. Leave empty to disable Slack entirely.
# The Slack app must list <PUBLIC_URL>/slack/callback as a redirect URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Where the hub keeps state.json (history) and members.json (tokens of people
# who joined from the site, mode 600).
DATA_DIR=./data

# Let colleagues join from the website (hub polls Spotify for them). 1/0.
WEB_JOIN=1

# Site password. Strongly recommended on a public host: every page (wall, join,
# settings) asks for it once, then the browser keeps a signed cookie.
# Changing it logs everyone out. Companions use HUB_SECRET, not this.
ACCESS_PASSWORD=

# Optional: only accept Slack logins from this workspace (team id, e.g. T0123ABCD).
# Find it in Slack: workspace menu -> Settings & administration -> About this workspace,
# or in the URL of https://app.slack.com/client/T.../
# SLACK_TEAM_ID=

# Fetch own /healthz every 10 min so free hosts do not sleep. Default: on when on Render.
# KEEPALIVE=1
